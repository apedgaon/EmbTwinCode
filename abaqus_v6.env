scratch = "/home/scratch"
standard_parallel = ALL
run_mode = BACKGROUND
mp_mode = MPI
mp_file_system = (DETECT,DETECT)
mp_num_parallel_ftps = (4, 4)

#        MPIE CPFEM Abaqus Environment File
#       ------------------------------------
# originally taken from Abaqus ver. 6.9.1
#
#
# Linux (Opteron/EM64T) Settings:
#
# Compile and Link command for user subroutines.
# Compile_cpp and link_exe for Abaqus make utility.
#
import os, re, glob, driverUtils

debug = True

# Always use the newest version
fortDefPath = '/'

dirLst = glob.glob('/opt/intel/fce/*')
if dirLst:
    dirLst.sort()
    fortDefPath = dirLst[-1] + '/bin'

fortCompiler = "ifort"

if os.path.exists(os.path.join(fortDefPath, fortCompiler)):
    fortCmd = os.path.join(fortDefPath, fortCompiler)
else:
    fortCmd = fortCompiler

cppCmd = 'g++'
simIncDir = '/usr/SIMULIA/EstProducts/2022'
eigIncDir = '/home/pedgaonkar/external/eigen-3.4.0'

# Add the flag "-free" to the compile_fortran command below to use free-
# format FORTRAN 90 syntax.
if debug:
    compile_fortran = (fortCmd + " -c -fPIC -auto -extend_source -w90 -w95 " + 
                   "-WB -I%I -I/usr/SIMULIA/EstProducts/2022 -g -fpp -qopenmp -check bounds")
    compile_cpp = [cppCmd, '-c', '-g', '-fPIC', '-I' + simIncDir, '-I' + eigIncDir]
else:
    compile_fortran = (fortCmd + " -c -fPIC -auto -extend_source -w90 -w95 " + 
                   "-WB -I%I -I/usr/SIMULIA/EstProducts/2022 -fpp -O2 -qopenmp")
    compile_cpp = [cppCmd, '-c', '-O2', '-fPIC', '-I' + simIncDir, '-I' + eigIncDir]

cae_no_parts_input_file=ON
memory = '90%'

# Remove the temporary names from the namespace
del fortCmd
del cppCmd
del simIncDir
del eigIncDir
del fortDefPath
del fortCompiler
del dirLst
del debug
abaquslm_license_file="27001@license.software.wisc.edu"
academic=RESEARCH
